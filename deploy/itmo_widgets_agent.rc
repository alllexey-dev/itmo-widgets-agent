#!/bin/sh
# shellcheck disable=SC1091,SC2034 # rc.subr is FreeBSD-only and reads these variables.
#
# PROVIDE: itmo_widgets_agent
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# FreeBSD rc.d script for the ITMO.Widgets agent. As root:
#   install -m 555 deploy/itmo_widgets_agent.rc /usr/local/etc/rc.d/itmo_widgets_agent
#   sysrc itmo_widgets_agent_enable=YES itmo_widgets_agent_user=YOUR_USER \
#     itmo_widgets_agent_bin=/home/YOUR_USER/.local/bin/itmo-widgets-agent
#   service itmo_widgets_agent start
# daemon(8) and the agent run as itmo_widgets_agent_user with that user's HOME, so `pair` run as the same user finds
# the same files. daemon restarts the agent 30 s after an exit. Logs: /var/log/itmo_widgets_agent.log

. /etc/rc.subr

name=itmo_widgets_agent
rcvar=itmo_widgets_agent_enable
load_rc_config $name

: "${itmo_widgets_agent_enable:=NO}"
: "${itmo_widgets_agent_user:=nobody}"
: "${itmo_widgets_agent_bin:=/usr/local/bin/itmo-widgets-agent}"
: "${itmo_widgets_agent_logfile:=/var/log/${name}.log}"

# The pid file and the log belong to the user: rc.subr starts daemon(8) as itmo_widgets_agent_user.
piddir="/var/run/${name}"
pidfile="${piddir}/${name}.pid"
command=/usr/sbin/daemon
command_args="-r -R 30 -P ${pidfile} -o ${itmo_widgets_agent_logfile} \
	/usr/bin/env HOME=$(getent passwd "${itmo_widgets_agent_user}" | cut -d: -f6) \
	${itmo_widgets_agent_bin} run --ui=plain"
start_precmd="${name}_precmd"

itmo_widgets_agent_precmd()
{
	install -d -o "${itmo_widgets_agent_user}" -m 755 "${piddir}"
	[ -e "${itmo_widgets_agent_logfile}" ] ||
		install -o "${itmo_widgets_agent_user}" -m 640 /dev/null "${itmo_widgets_agent_logfile}"
}

run_rc_command "$1"
